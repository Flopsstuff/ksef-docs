# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in the values you need.
#
#   cp .env.example .env
#
# Only required for translation (yarn translate / yarn translate:openapi / yarn
# check). NOT needed for building the site (yarn docs:build / yarn docs:dev).
# Verify your setup any time with:  yarn check
# ─────────────────────────────────────────────────────────────────────────────

# Which backend to use for translation.
#   anthropic  — Anthropic API directly (needs ANTHROPIC_API_KEY)
#   bedrock    — Claude on AWS Bedrock (uses the standard AWS credential chain)
#   openrouter — OpenAI-compatible gateway, one key for many models (needs OPENROUTER_API_KEY)
# Default: anthropic
TRANSLATION_PROVIDER=anthropic

# ── Provider credentials ─────────────────────────────────────────────────────

# Required when TRANSLATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required when TRANSLATION_PROVIDER=openrouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# For TRANSLATION_PROVIDER=bedrock, no key is set here — auth uses the standard
# AWS credential chain (AWS_PROFILE, or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY).
# AWS_PROFILE=my-profile
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# AWS region for the Bedrock provider. Default: eu-central-1
AWS_REGION=eu-central-1

# ── Model selection ──────────────────────────────────────────────────────────
# Model resolution order (first match wins):
#   1. --model=<id> CLI flag
#   2. TRANSLATION_MODEL          (generic, applies to ANY provider)
#   3. provider-specific *_MODEL  (below)
#   4. built-in default per provider:
#        anthropic  -> claude-sonnet-4-6
#        bedrock    -> eu.anthropic.claude-sonnet-4-20250514-v1:0
#        openrouter -> anthropic/claude-sonnet-4.5
# Leave everything unset to use the defaults.

# Generic override for whichever provider is active:
# TRANSLATION_MODEL=anthropic/claude-sonnet-4.5

# Or override per provider:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# BEDROCK_MODEL=eu.anthropic.claude-sonnet-4-20250514-v1:0
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Fallback chain: if the primary model fails (404/429/timeout), the next one is
# tried automatically. Numbered _2, _3, … (scanned up to _10). Works for any
# provider via TRANSLATION_MODEL_<i>, or per provider via <PROVIDER>_MODEL_<i>.
# Example (free OpenRouter models, picked via `yarn benchmark:free`):
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_2=openai/gpt-oss-120b:free

# ── Tuning ───────────────────────────────────────────────────────────────────

# Max parallel translation requests. Keep low to avoid provider rate limits
# (e.g. output-tokens-per-minute). Default: 2
TRANSLATION_CONCURRENCY=2
